# Organic Growth OS — example environment file.
#
# Copy to `.env` for local development: cp .env.example .env
# NEVER commit a real .env. NEVER put real credentials in this file.
# Every variable below is non-secret. Secret-bearing variables (database URLs,
# OAuth client secrets, encryption keys) arrive in later sub-phases and are loaded
# from the environment / secret manager only — see docs/SECURITY.md §5.
#
# Values shown are the defaults applied by packages/config when a variable is unset.

# --- Runtime (server-side only) ---
NODE_ENV=development
LOG_LEVEL=info
SERVICE_VERSION=0.0.0-dev

# --- apps/api ---
API_HOST=127.0.0.1
API_PORT=3001

# --- apps/worker ---
WORKER_HEARTBEAT_INTERVAL_MS=60000

# --- apps/web (public: inlined into the browser bundle, never secret) ---
NEXT_PUBLIC_APP_NAME=Organic Growth OS

# --- Authentication (docs/phases/PHASE-0.3-IMPLEMENTATION.md) ------------------
# AUTH_SESSION_SECRET is a real secret: it keys the CSRF token MAC. The value below
# is LOCAL DEVELOPMENT ONLY. Real environments take it from the secret manager, and
# it must be at least 32 characters of high-entropy material, e.g.
#   node -e "process.stdout.write(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=local-dev-only-auth-secret-not-for-any-real-environment

# Session lifetimes. Absolute = hard cap; idle = inactivity cap. Both configurable;
# idle must not exceed absolute.
AUTH_SESSION_ABSOLUTE_LIFETIME_MS=43200000
AUTH_SESSION_IDLE_TIMEOUT_MS=7200000
# Minimum interval between last_used_at writes.
AUTH_SESSION_TOUCH_INTERVAL_MS=60000
# How long finished sessions are kept before `pnpm sessions:cleanup` deletes them.
AUTH_SESSION_CLEANUP_GRACE_MS=604800000

# Cookie policy. Production ALWAYS uses Secure __Host- cookies and refuses to start
# otherwise; this variable only exists so local HTTP development can use its own,
# separately named development cookies. Setting it to `true` locally (with HTTPS)
# switches to the production profile.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Login rate limiting. Single-process until sub-phase 0.5 provides a shared store.
AUTH_LOGIN_RATE_LIMIT_IP_MAX=20
AUTH_LOGIN_RATE_LIMIT_ACCOUNT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Argon2id cost. Defaults are the OWASP baseline (19 MiB, t=2, p=1); raise as
# hardware improves, never lower in production.
# AUTH_ARGON2_MEMORY_COST_KIB=19456
# AUTH_ARGON2_TIME_COST=2
# AUTH_ARGON2_PARALLELISM=1

# --- Database -----------------------------------------------------------------
# Each role has its own connection string; see docs/phases/PHASE-0.2-IMPLEMENTATION.md.
# The passwords below are LOCAL DEVELOPMENT ONLY and must never be reused anywhere
# else. Real environments take these from the secret manager, never from a file.
#
# Start the local server with `docker compose up -d`, then run:
#   pnpm db:bootstrap    (once — creates extensions and roles; needs the admin URL)
#   pnpm db:migrate

# Application role: constrained by Row Level Security, cannot change the schema.
DATABASE_URL=postgres://organic_os_runtime:local-dev-only-runtime@127.0.0.1:5432/organic_os
DATABASE_MAX_CONNECTIONS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TX_TIMEOUT_MS=15000

# Migration role: owns the schema. Used only by the migration CLI.
DATABASE_MIGRATOR_URL=postgres://organic_os_migrator:local-dev-only-migrator@127.0.0.1:5432/organic_os

# Provisioning role: creates organizations and users. No schema rights.
DATABASE_PROVISIONER_URL=postgres://organic_os_provisioner:local-dev-only-provisioner@127.0.0.1:5432/organic_os

# Superuser: used only by `pnpm db:bootstrap` and `pnpm db:reset`.
DATABASE_ADMIN_URL=postgres://organic_os_admin:local-dev-only-password@127.0.0.1:5432/organic_os
DATABASE_MIGRATOR_PASSWORD=local-dev-only-migrator
DATABASE_RUNTIME_PASSWORD=local-dev-only-runtime
DATABASE_PROVISIONER_PASSWORD=local-dev-only-provisioner

# Optional: run the integration suite against an existing PostgreSQL 16+ server
# (superuser, pgvector available) instead of starting one with Testcontainers.
# TEST_DATABASE_ADMIN_URL=postgres://postgres:password@127.0.0.1:5432/postgres
