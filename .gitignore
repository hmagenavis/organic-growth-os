# Dependencies
node_modules/

# Build output
dist/
.next/
out/
*.tsbuildinfo
# Emitted siblings of the *.config.ts files that live outside src/. Named explicitly
# rather than as *.config.js, which would shadow the tracked eslint.config.js.
vitest.config.js
vitest.config.js.map
vitest.integration.config.js
vitest.integration.config.js.map

# Generated by `next build`; it references files inside .next/, so committing it would
# break a typecheck on a fresh checkout.
next-env.d.ts

# Tooling caches
.turbo/
coverage/

# Environment files — never commit real values. Only .env.example is tracked.
.env
.env.*
!.env.example

# Logs and OS noise
*.log
.DS_Store
Thumbs.db
