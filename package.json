{
  "name": "organic-growth-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @organic-os/database test:integration && pnpm --filter @organic-os/api test:integration",
    "db:bootstrap": "pnpm --filter @organic-os/database db:bootstrap",
    "db:migrate": "pnpm --filter @organic-os/database db:migrate",
    "db:status": "pnpm --filter @organic-os/database db:status",
    "db:reset": "pnpm --filter @organic-os/database db:reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sessions:cleanup": "pnpm --filter @organic-os/worker sessions:cleanup"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
