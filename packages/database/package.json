{
  "name": "@organic-os/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:bootstrap": "tsx src/cli/bootstrap.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:status": "tsx src/cli/status.ts",
    "db:reset": "tsx src/cli/reset.ts",
    "provision:organization": "tsx src/cli/provision-organization.ts",
    "db:verify:staging": "tsx src/cli/verify-staging.ts"
  },
  "dependencies": {
    "@organic-os/auth": "workspace:*",
    "@organic-os/authorization": "workspace:*",
    "@organic-os/observability": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
